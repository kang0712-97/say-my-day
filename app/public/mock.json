  "grammar": [
    {
      "pattern": "A，却 B (대비)",
      "explanation_ko": "앞 내용과 반대되는 상황을 말할 때 씁니다. 却는 주어 뒤, 동사 앞에 둡니다.",
      "example_zh": "天气不好，我的心情却很好。",
      "example_ko": "날씨는 안 좋은데 내 기분은 오히려 좋아요."
    },
    {
      "pattern": "变得 + 형용사 (변화의 결과)",
